{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragz.example/schemas/cag/schedule.schema.json",
  "title": "Sanitized frozen CAG trial schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_sha256",
    "seed",
    "repetitions",
    "variants",
    "assignments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "integer"},
    "repetitions": {"type": "integer", "minimum": 1},
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$"}
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "pair_id",
          "question_id",
          "stratum",
          "repetition",
          "order_index",
          "variant"
        ],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "pair_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "question_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "stratum": {"type": "string", "minLength": 1, "maxLength": 128},
          "repetition": {"type": "integer", "minimum": 1},
          "order_index": {"type": "integer", "minimum": 1},
          "variant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$"}
        }
      }
    }
  }
}
